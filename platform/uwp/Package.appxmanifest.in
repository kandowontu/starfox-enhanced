<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="mp uap">
  <Identity
    Name="StarFoxEnhanced.Dev"
    Publisher="CN=StarFoxEnhanced"
    Version="@PROJECT_VERSION@.0" />
  <mp:PhoneIdentity
    PhoneProductId="21cc9162-ecf4-40ed-b7e7-b16fdb867d1e"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Star Fox Enhanced</DisplayName>
    <PublisherDisplayName>Star Fox Enhanced team</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Universal"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
    <PackageDependency
      Name="Microsoft.VCLibs.140.00"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
      MinVersion="14.0.30704.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application
      Id="App"
      Executable="starfox_pc.exe"
      EntryPoint="starfox_pc.App">
      <uap:VisualElements
        DisplayName="Star Fox Enhanced"
        Description="Native Star Fox Enhanced runtime"
        BackgroundColor="#081528"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen
          Image="Assets\SplashScreen.png"
          BackgroundColor="#081528" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
